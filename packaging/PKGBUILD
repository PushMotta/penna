# Maintainer: Pedro Motta
#
# Builds the package from this checkout, uncommitted changes included: `cd packaging && makepkg -f`. The AUR's is aur/PKGBUILD,
# which builds a tagged release; its build(), check() and package() must stay the same as these.
pkgname=penna
pkgver=0.10.2
pkgrel=1
pkgdesc="Fan control for Linux, made to be understood: a daemon that always hands fans back, a CLI, and an Omarchy plugin"
arch=('x86_64')
url="https://github.com/PushMotta/penna"
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
optdepends=('nvidia-utils: NVIDIA GPU fans'
            'it87-dkms-git: motherboard fans on boards with ITE Super I/O chips the stock it87 does not know'
            'power-profiles-daemon: the power profile as the fan lever on laptops whose fans Penna cannot drive')
install=penna.install

_root() { cd "$startdir/.."; }

prepare() {
  _root
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _root
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  _root
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --workspace --frozen
}

package() {
  _root
  install -Dm755 target/release/pennad "$pkgdir/usr/bin/pennad"
  install -Dm755 target/release/penna "$pkgdir/usr/bin/penna"
  install -Dm644 packaging/pennad.service "$pkgdir/usr/lib/systemd/system/pennad.service"
  install -Dm644 packaging/penna.sysusers "$pkgdir/usr/lib/sysusers.d/penna.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/penna/LICENSE"
  install -Dm644 DESIGN.md README.md CONTRIBUTING.md -t "$pkgdir/usr/share/doc/penna/"
  # The board database (DESIGN.md §3.6).
  install -Dm644 data/boards/*.toml -t "$pkgdir/usr/share/penna/boards/"
  # The Omarchy plugin, the same release as pennad, to link into ~/.config/omarchy/plugins/io.github.pushmotta.penna.
  install -d "$pkgdir/usr/share/penna/plugin"
  cp -r --no-preserve=ownership plugin/manifest.json plugin/*.qml plugin/Model.js plugin/components "$pkgdir/usr/share/penna/plugin/"
}
